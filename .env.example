# Proveedor LLM: lmstudio | omniroute | bedrock | router
LLM_PROVIDER=lmstudio
# Embeddings para RAG (OmniRoute no tiene): lmstudio | bedrock
EMBED_PROVIDER=lmstudio
# Router en cascada: niveles proveedor:modelo, del mas rapido al mas capaz
ROUTER_TIERS=omniroute:kr/minimax-m2.1,lmstudio:qwen/qwen3.6-35b-a3b

# --- LM Studio (local, $0) ---  MacBook M5 Pro, 35 GB RAM unificada
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Usa el ID exacto que muestra LM Studio (pestaña Developer -> modelos cargados)
LMSTUDIO_CHAT_MODEL=qwen/qwen3.6-35b-a3b
LMSTUDIO_EMBED_MODEL=text-embedding-bge-m3

# --- OmniRoute (gateway local a modelos gratuitos, solo datos sinteticos) ---
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=changeme
# auto/* enruta a modelos distintos en cada llamada: para evals fija uno (p. ej. kr/minimax-m2.1)
OMNIROUTE_CHAT_MODEL=auto/best-free

# --- AWS Bedrock (opcional, usa creditos) ---
AWS_PROFILE=aif
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- PostgreSQL + pgvector (Docker) ---
PG_DSN=postgresql://copilot_ro:copilot_ro@localhost:5432/inventory
PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/inventory
# Semana 4: roles de minimo privilegio para ordenes de compra y auditoria
PO_DSN=postgresql://copilot_po:copilot_po@localhost:5432/inventory
APPROVER_DSN=postgresql://copilot_approver:copilot_approver@localhost:5432/inventory
AUDIT_DSN=postgresql://copilot_audit:copilot_audit@localhost:5432/inventory

# --- Guardrails ---
# Clasificador de inyeccion con LLM (segunda capa, opcional): on | off
GUARDRAIL_LLM_CLASSIFIER=off
GUARDRAIL_CLASSIFIER_PROVIDER=omniroute:kr/minimax-m2.1
# Amazon Bedrock Guardrails (ApplyGuardrail); vacio = desactivado. Se crea con CDK en la Semana 6
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
